{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NameTent Studio",
  "version": "0.1.0",
  "identifier": "com.bizcom.nametentstudio",
  "build": {
    "beforeDevCommand": "python3 dev.py",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "python3 build.py",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "NameTent Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; font-src 'self' data: blob: http: https:; connect-src 'self' http: https:; frame-src 'self' http: https: data: blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
